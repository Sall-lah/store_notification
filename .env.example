# Application Environment (development, staging, production)
APP_ENV=development
PORT=8070

# Apache Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=store-notification-group
KAFKA_TOPICS=auth.events,order.events

# Redis Configuration (Idempotency deduplication)
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
IDEMPOTENCY_TTL_HOURS=24

# SMTP Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@store.example.com
SMTP_FROM_NAME="Store Notifications"
SMTP_REQUIRE_TLS=false
SMTP_INSECURE_SKIP_VERIFY=true

# Store Administrator Alert Emails (Comma separated)
STORE_ADMIN_EMAILS=admin@store.example.com,ops@store.example.com
